# Base URL of the backend API (see ../backend). Same-origin in local dev if
# you proxy /api/**, otherwise the full backend URL (e.g. the Render deploy).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Server-only override of the backend URL, preferred over NEXT_PUBLIC_API_URL
# when set (see src/lib/backend-client.ts and src/server/auth/config.ts).
# Also whitelisted in next.config.ts's CSP connect-src for the notification
# bell's direct-to-backend EventSource connection. Usually not needed
# separately from NEXT_PUBLIC_API_URL — set it only if the server-side and
# client-side URLs to reach backend/ actually differ (e.g. an internal
# service hostname vs. a public one).
BACKEND_URL=""

# Auth.js v5 — this app's own NextAuth instance (independent from backend/'s;
# see src/server/auth/config.ts). Required in production.
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_URL="http://localhost:3020"

NEXT_PUBLIC_APP_NAME="DeshIT-BD SME ERP"
