{
  "name": "annex-leather-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DeshIT-BD SME ERP — backend API only (Next.js Route Handlers + Prisma + MySQL/TiDB). Serves the web app and the Flutter mobile app.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate && node scripts/cpanel-postinstall-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "jose": "^6.2.7",
    "jsbarcode": "^3.12.3",
    "next": "^15.5.15",
    "next-auth": "5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "mysql2": "^3.24.3",
    "pg": "^8.23.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
