# MySQL (TiDB Cloud Serverless in staging/production — MySQL-wire-protocol
# compatible, so any local MySQL 8+ works for dev). TiDB's public endpoint
# requires TLS; keep `sslaccept=strict` when pointing at a TiDB cluster.
# For a local MySQL instance without TLS, drop the query param entirely.
DATABASE_URL="mysql://root:root@localhost:3306/annex_leather_erp"

# Auth.js v5 / mobile JWT
# AUTH_SECRET is also reused (see src/server/auth/mobile-jwt.ts) to sign the
# short-lived Bearer access tokens and SSE tokens issued to web/ and the
# Flutter app under /api/mobile/**, so keep it set even if you never touch
# the cookie-based /api/auth/** routes directly.
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_URL="http://localhost:3000"

# CORS allowlist for the API (comma-separated exact origins, e.g.
# "https://app.example.com,https://staging.example.com"). Leave unset in
# local dev to reflect any request origin (see src/middleware.ts).
ALLOWED_ORIGINS=""

# Resend (email)
RESEND_API_KEY=""
EMAIL_NOTIFICATIONS_ENABLED="false"
EMAIL_FROM="Annex ERP <no-reply@example.com>"
EMAIL_REPLY_TO=""

# App
NEXT_PUBLIC_APP_NAME="DeshIT-BD SME ERP"

# Local disk storage driver — root directory for uploaded files (relative to
# the backend/ working directory). Only used when the storage driver is
# "local" (see src/server/storage/local.ts).
UPLOAD_DIR="storage/uploads"

# Google Drive storage (optional — only needed when storage driver = google-drive)
# Paste the full service account key JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Backblaze B2 storage (optional — only needed when storage driver = backblaze)
# Used via B2's S3-compatible API (see src/server/storage/backblaze.ts).
# Create an Application Key scoped to a single bucket in the B2 dashboard.
# Endpoint/region come from the bucket's "Endpoint" field, e.g. bucket
# endpoint "s3.us-west-004.backblazeb2.com" -> region "us-west-004".
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_BUCKET=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
