// DeshIT-BD SME ERP — Prisma schema
// Phase 0 foundation tables only. Module-specific models (inventory,
// sales, accounts, etc.) are added as their modules are built.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

