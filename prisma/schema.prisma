model FinishedGoodsReceiveVoucher {
  id          String          @id @default(cuid())
  receiveNo   String          @unique
  date        DateTime        @db.Date
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id])
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])

  receivedById String?
  receivedBy   User?   @relation("FgReceivedBy", fields: [receivedById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("FgApprovedBy", fields: [approvedById], references: [id])

  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FinishedGoodsReceiveItem[]
}

model FinishedGoodsReceiveItem {
  id        String                      @id @default(cuid())
  voucherId String
  voucher   FinishedGoodsReceiveVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId String
  product   Product                     @relation(fields: [productId], references: [id])
  batchNo   String?

  quantity      Decimal            @db.Decimal(18, 4)
  uom           UnitOfMeasure      @default(PCS)
  qualityStatus QualityCheckStatus @default(PENDING)
}

// ─────────────────────────────────────────────────────────────────────────────
// Asset Management
// ─────────────────────────────────────────────────────────────────────────────

model AssetCategory {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name               String
  description        String?
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  /// Default useful life (months) used when creating assets in this category
  defaultLifeMonths  Int                @default(60)
  /// Default salvage rate as a fraction of purchase cost (0.00-1.00)
  defaultSalvageRate Decimal            @default(0) @db.Decimal(5, 4)
  assets             Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Asset {
  id                      String             @id @default(cuid())
  branchId                String
  branch                  Branch             @relation(fields: [branchId], references: [id])
  categoryId              String?
  category                AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Human asset code (e.g. AST-0001)
  code                    String
  name                    String
  description             String?
  serialNumber            String?
  location                String?
  assignedTo              String?
  condition               AssetCondition     @default(GOOD)
  status                  AssetStatus        @default(IN_USE)
  purchaseDate            DateTime
  purchaseCost            Decimal            @db.Decimal(18, 4)
  salvageValue            Decimal            @default(0) @db.Decimal(18, 4)
  usefulLifeMonths        Int                @default(60)
  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 4)
  lastDepreciatedAt       DateTime?
  disposedAt              DateTime?
  disposalValue           Decimal?           @db.Decimal(18, 4)
  disposalReason          String?
  notes                   String?
  createdById             String?

  movements AssetMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([categoryId])
  @@index([serialNumber])
}

model AssetMovement {
  id           String            @id @default(cuid())
  assetId      String
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  type         AssetMovementType
  fromLocation String?
  toLocation   String?
  fromAssignee String?
  toAssignee   String?
  amount       Decimal?          @db.Decimal(18, 4)
  note         String?
  createdById  String?

  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@index([branchId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Approval Workflow
// ApprovalRule: configurable (module + action + optional amount threshold) →
//   ordered list of approver roles. Rules are evaluated when a restricted
//   action is submitted, creating an ApprovalRequest with one ApprovalStep
//   per role in sequence.
// ─────────────────────────────────────────────────────────────────────────────

model ApprovalRule {
  id                 String   @id @default(cuid())
  name               String
  module             String
  action             String
  /// Minimum amount (inclusive) for this rule to apply. 0 = always applies.
  minAmount          Decimal  @default(0) @db.Decimal(18, 4)
  /// Ordered role names that must approve, highest-trust last.
  approverRoles      String[]
  escalateAfterHours Int      @default(24)
  isActive           Boolean  @default(true)
  description        String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  approvalRequests ApprovalRequest[]

  @@unique([module, action, minAmount])
  @@index([module, action, isActive])
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  ruleId        String?
  rule          ApprovalRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  module        String
  action        String
  entityType    String
  entityId      String
  title         String
  summary       String?
  amount        Decimal?       @db.Decimal(18, 4)
  currency      CurrencyCode?
  branchId      String?
  requestedById String
  status        ApprovalStatus @default(PENDING)
  decidedAt     DateTime?
  note          String?

  steps ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module, action, status])
  @@index([entityType, entityId])
  @@index([requestedById, status])
  @@index([status, createdAt])
}

model ApprovalStep {
  id           String             @id @default(cuid())
  requestId    String
  request      ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sequence     Int
  approverRole String
  approverId   String?
  status       ApprovalStepStatus @default(WAITING)
  decidedAt    DateTime?
  note         String?

  createdAt DateTime @default(now())

  @@unique([requestId, sequence])
  @@index([requestId, status])
  @@index([approverRole, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// App Settings
// Key-value store for system-wide configuration (storage driver, integrations).
// ─────────────────────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Document Management
// Documents are file records; DocumentLink attaches them to any entity via a
// polymorphic (entityType + entityId) pointer.
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String    @id @default(cuid())
  branchId     String?
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storagePath  String
  category     String?
  tags         String[]
  expiresAt    DateTime?
  uploadedById String
  notes        String?

  links DocumentLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, createdAt])
  @@index([category])
  @@index([expiresAt])
}

model DocumentLink {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The target model name (e.g. "PurchaseOrder", "Supplier")
  entityType String
  entityId   String
  note       String?

  createdAt DateTime @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM (Customer Relationship Management)
// ─────────────────────────────────────────────────────────────────────────────

model CustomerCategory {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  description String?
  /// Default discount % for this category (0–100)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  isActive    Boolean @default(true)

  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Customer {
  id             String            @id @default(cuid())
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  /// Human customer code (e.g. CUS-001)
  code           String
  name           String
  type           CustomerType      @default(RETAIL)
  categoryId     String?
  category       CustomerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  /// Credit limit — 0 means cash-only
  creditLimit    Decimal           @default(0) @db.Decimal(18, 4)
  creditDays     Int               @default(0)
  currency       CurrencyCode      @default(BDT)
  openingBalance Decimal           @default(0) @db.Decimal(18, 4)
  loyaltyPoints  Int               @default(0)
  status         CustomerStatus    @default(ACTIVE)
  notes          String?
  createdById    String?

  interactions      CustomerInteraction[]
  ledger            CustomerLedger[]
  posSales          PosSale[]
  wholesaleInvoices WholesaleInvoice[]
  corporateQuotes   CorporateQuote[]
  corporateOrders   CorporateOrder[]
  corporateInvoices CorporateInvoice[]
  tradeOrders       TradeOrder[]
  ecommerceOrders   EcommerceOrder[]
  cashEntries       CashEntry[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  corporateSalesReturns CorporateSalesReturn[]

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([type])
  @@index([name])
}

model CustomerInteraction {
  id          String                  @id @default(cuid())
  customerId  String
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        CustomerInteractionType @default(NOTE)
  subject     String
  body        String?
  /// Follow-up date (when type = FOLLOW_UP or a call needs a callback)
  followUpAt  DateTime?
  completedAt DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([followUpAt])
}

model CustomerLedger {
  id          String                  @id @default(cuid())
  branchId    String
  branch      Branch                  @relation(fields: [branchId], references: [id])
  customerId  String
  customer    Customer                @relation(fields: [customerId], references: [id])
  entryType   CustomerLedgerEntryType
  refType     String
  refId       String?
  description String
  debit       Decimal                 @default(0) @db.Decimal(18, 4)
  credit      Decimal                 @default(0) @db.Decimal(18, 4)
  entryDate   DateTime                @default(now())
  createdById String?

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
  @@index([refType, refId])
}

// ─────────────────────────────────────────────────────────────────────────────
// POS (Point of Sale)
// Cashier opens a session (with opening float) at a warehouse-backed till.
// Each sale issues InventoryLedger OUT rows + CustomerLedger rows for credit
// inside a single $transaction. Returns reverse both.
// ─────────────────────────────────────────────────────────────────────────────

model PosSession {
  id           String           @id @default(cuid())
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  /// Cashier user id (denormalised; POS traffic rarely needs the User row)
  cashierId    String
  openedAt     DateTime         @default(now())
  closedAt     DateTime?
  openingFloat Decimal          @default(0) @db.Decimal(18, 4)
  expectedCash Decimal          @default(0) @db.Decimal(18, 4)
  countedCash  Decimal          @default(0) @db.Decimal(18, 4)
  cashVariance Decimal          @default(0) @db.Decimal(18, 4)
  status       PosSessionStatus @default(OPEN)
  notes        String?

  sales   PosSale[]
  returns PosReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([cashierId, status])
  @@index([openedAt])
}

model PosSale {
  id            String        @id @default(cuid())
  /// Human sale number (e.g. POS-2026-000123)
  number        String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  sessionId     String?
  session       PosSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashierId     String
  saleDate      DateTime      @default(now())
  currency      CurrencyCode  @default(BDT)
  subtotal      Decimal       @default(0) @db.Decimal(18, 4)
  discountTotal Decimal       @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal       @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal       @default(0) @db.Decimal(18, 4)
  paidTotal     Decimal       @default(0) @db.Decimal(18, 4)
  changeDue     Decimal       @default(0) @db.Decimal(18, 4)
  creditAmount  Decimal       @default(0) @db.Decimal(18, 4)
  status        PosSaleStatus @default(COMPLETED)
  notes         String?

  items    PosSaleItem[]
  payments PosSalePayment[]
  returns  PosReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, saleDate])
  @@index([cashierId, saleDate])
  @@index([customerId, saleDate])
  @@index([sessionId])
}

model PosSaleItem {
  id           String        @id @default(cuid())
  saleId       String
  sale         PosSale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  description  String?
  unit         UnitOfMeasure @default(PCS)
  quantity     Decimal       @db.Decimal(18, 4)
  unitPrice    Decimal       @db.Decimal(18, 4)
  discountRate Decimal       @default(0) @db.Decimal(5, 2)
  taxRate      Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal       @db.Decimal(18, 4)
  returnedQty  Decimal       @default(0) @db.Decimal(18, 4)

  returnItems PosReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model PosSalePayment {
  id        String           @id @default(cuid())
  saleId    String
  sale      PosSale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PosPaymentMethod
  amount    Decimal          @db.Decimal(18, 4)
  reference String?

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([method])
}

model PosReturn {
  id           String           @id @default(cuid())
  /// Human return number (e.g. POSR-2026-000123)
  number       String           @unique
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  warehouseId  String
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  saleId       String
  sale         PosSale          @relation(fields: [saleId], references: [id])
  sessionId    String?
  session      PosSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  returnDate   DateTime         @default(now())
  refundAmount Decimal          @default(0) @db.Decimal(18, 4)
  refundMethod PosPaymentMethod @default(CASH)
  status       PosReturnStatus  @default(COMPLETED)
  reason       String?
  createdById  String?

  items PosReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, returnDate])
  @@index([saleId])
}

model PosReturnItem {
  id         String      @id @default(cuid())
  returnId   String
  return     PosReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   PosSaleItem @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  quantity   Decimal     @db.Decimal(18, 4)
  unitPrice  Decimal     @db.Decimal(18, 4)
  lineTotal  Decimal     @db.Decimal(18, 4)

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// E-commerce / Online Sales
// External storefront orders are synced into ERP, packed/fulfilled against
// warehouse stock, returned/refunded, and reconciled against settlement records.
// ─────────────────────────────────────────────────────────────────────────────

enum EcommerceChannelType {
  SHOPIFY
  WOOCOMMERCE
  FACEBOOK
  DARAZ
  MANUAL
  OTHER
}

enum EcommerceOrderStatus {
  SYNCED
  PACKING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}

enum EcommerceFulfillmentStatus {
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum EcommercePaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  RECONCILED
  REFUNDED
}

enum EcommerceReturnStatus {
  REQUESTED
  RECEIVED
  REFUNDED
  REJECTED
}

enum EcommerceReconciliationStatus {
  DRAFT
  COMPLETED
  FAILED
}

model EcommerceChannel {
  id         String               @id @default(cuid())
  branchId   String
  branch     Branch               @relation(fields: [branchId], references: [id])
  code       String
  name       String
  type       EcommerceChannelType @default(MANUAL)
  storeUrl   String?
  isActive   Boolean              @default(true)
  lastSyncAt DateTime?

  orders             EcommerceOrder[]
  reconciliationRuns EcommerceReconciliationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId, isActive])
}

model EcommerceOrder {
  id               String                 @id @default(cuid())
  channelId        String
  channel          EcommerceChannel       @relation(fields: [channelId], references: [id])
  branchId         String
  branch           Branch                 @relation(fields: [branchId], references: [id])
  warehouseId      String?
  warehouse        Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  externalId       String
  number           String                 @unique
  orderDate        DateTime               @default(now())
  status           EcommerceOrderStatus   @default(SYNCED)
  paymentStatus    EcommercePaymentStatus @default(PENDING)
  currency         CurrencyCode           @default(BDT)
  subtotal         Decimal                @default(0) @db.Decimal(18, 4)
  discountTotal    Decimal                @default(0) @db.Decimal(18, 4)
  shippingTotal    Decimal                @default(0) @db.Decimal(18, 4)
  taxTotal         Decimal                @default(0) @db.Decimal(18, 4)
  grandTotal       Decimal                @default(0) @db.Decimal(18, 4)
  paidTotal        Decimal                @default(0) @db.Decimal(18, 4)
  reconciledAmount Decimal                @default(0) @db.Decimal(18, 4)
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  shipToAddress    String?
  courier          String?
  trackingNo       String?
  notes            String?
  createdById      String?

  items        EcommerceOrderItem[]
  fulfillments EcommerceFulfillment[]
  payments     EcommercePayment[]
  returns      EcommerceReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelId, externalId])
  @@index([branchId, status, orderDate])
  @@index([customerId, orderDate])
  @@index([paymentStatus])
}

model EcommerceOrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku          String
  name         String
  unit         UnitOfMeasure  @default(PCS)
  quantity     Decimal        @db.Decimal(18, 4)
  packedQty    Decimal        @default(0) @db.Decimal(18, 4)
  fulfilledQty Decimal        @default(0) @db.Decimal(18, 4)
  returnedQty  Decimal        @default(0) @db.Decimal(18, 4)
  unitPrice    Decimal        @db.Decimal(18, 4)
  discountRate Decimal        @default(0) @db.Decimal(5, 2)
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal        @db.Decimal(18, 4)

  fulfillmentItems EcommerceFulfillmentItem[]
  returnItems      EcommerceReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([sku])
}

model EcommerceFulfillment {
  id          String                     @id @default(cuid())
  orderId     String
  order       EcommerceOrder             @relation(fields: [orderId], references: [id])
  branchId    String
  branch      Branch                     @relation(fields: [branchId], references: [id])
  warehouseId String
  warehouse   Warehouse                  @relation(fields: [warehouseId], references: [id])
  status      EcommerceFulfillmentStatus @default(PACKED)
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  courier     String?
  trackingNo  String?
  createdById String?

  items EcommerceFulfillmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([branchId, status])
}

model EcommerceFulfillmentItem {
  id            String               @id @default(cuid())
  fulfillmentId String
  fulfillment   EcommerceFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     EcommerceOrderItem   @relation(fields: [orderItemId], references: [id])
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity      Decimal              @db.Decimal(18, 4)

  @@index([fulfillmentId])
  @@index([orderItemId])
  @@index([productId])
}

model EcommercePayment {
  id           String                 @id @default(cuid())
  orderId      String
  order        EcommerceOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch                 @relation(fields: [branchId], references: [id])
  method       PosPaymentMethod
  provider     String?
  externalId   String?
  amount       Decimal                @db.Decimal(18, 4)
  fee          Decimal                @default(0) @db.Decimal(18, 4)
  receivedAt   DateTime               @default(now())
  reconciledAt DateTime?
  status       EcommercePaymentStatus @default(PAID)
  createdById  String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([branchId, receivedAt])
  @@index([externalId])
}

model EcommerceReturn {
  id              String                @id @default(cuid())
  orderId         String
  order           EcommerceOrder        @relation(fields: [orderId], references: [id])
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  status          EcommerceReturnStatus @default(RECEIVED)
  refundAmount    Decimal               @default(0) @db.Decimal(18, 4)
  refundMethod    PosPaymentMethod      @default(CASH)
  refundReference String?
  reason          String?
  receivedAt      DateTime              @default(now())
  createdById     String?

  items EcommerceReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([branchId, receivedAt])
}

model EcommerceReturnItem {
  id          String             @id @default(cuid())
  returnId    String
  return      EcommerceReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   EcommerceOrderItem @relation(fields: [orderItemId], references: [id])
  productId   String?
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Decimal            @db.Decimal(18, 4)
  lineTotal   Decimal            @db.Decimal(18, 4)

  @@index([returnId])
  @@index([orderItemId])
  @@index([productId])
}

model EcommerceReconciliationRun {
  id             String                        @id @default(cuid())
  branchId       String
  branch         Branch                        @relation(fields: [branchId], references: [id])
  channelId      String
  channel        EcommerceChannel              @relation(fields: [channelId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  status         EcommerceReconciliationStatus @default(DRAFT)
  matchedCount   Int                           @default(0)
  unmatchedCount Int                           @default(0)
  totalSettled   Decimal                       @default(0) @db.Decimal(18, 4)
  notes          String?
  createdById    String?

  createdAt DateTime @default(now())

  @@index([branchId, periodStart, periodEnd])
  @@index([channelId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Wholesale — customer-based bulk invoicing with credit / due tracking.
// Simpler than POS: no cash session; invoices carry a dueDate and balanceDue
// that drops as WholesalePayments arrive. Returns reverse stock + ledger.
// ─────────────────────────────────────────────────────────────────────────────

enum WholesaleInvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
  PARTIALLY_RETURNED
  RETURNED
}

enum WholesaleReturnStatus {
  COMPLETED
  VOIDED
}

model WholesaleInvoice {
  id            String                 @id @default(cuid())
  /// Human invoice number (e.g. WS-2026-000123)
  number        String                 @unique
  branchId      String
  branch        Branch                 @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id])
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  salesRepId    String?
  invoiceDate   DateTime               @default(now())
  dueDate       DateTime?
  currency      CurrencyCode           @default(BDT)
  subtotal      Decimal                @default(0) @db.Decimal(18, 4)
  discountTotal Decimal                @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal                @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal                @default(0) @db.Decimal(18, 4)
  paidTotal     Decimal                @default(0) @db.Decimal(18, 4)
  balanceDue    Decimal                @default(0) @db.Decimal(18, 4)
  status        WholesaleInvoiceStatus @default(CONFIRMED)
  notes         String?
  createdById   String?

  items    WholesaleInvoiceItem[]
  payments WholesalePayment[]
  returns  WholesaleReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, invoiceDate])
  @@index([customerId, invoiceDate])
  @@index([dueDate])
}

model WholesaleInvoiceItem {
  id           String           @id @default(cuid())
  invoiceId    String
  invoice      WholesaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  description  String?
  unit         UnitOfMeasure    @default(PCS)
  quantity     Decimal          @db.Decimal(18, 4)
  unitPrice    Decimal          @db.Decimal(18, 4)
  discountRate Decimal          @default(0) @db.Decimal(5, 2)
  taxRate      Decimal          @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal          @db.Decimal(18, 4)
  returnedQty  Decimal          @default(0) @db.Decimal(18, 4)

  returnItems WholesaleReturnItem[]

  @@index([invoiceId])
  @@index([productId])
}

model WholesalePayment {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     WholesaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      PosPaymentMethod
  amount      Decimal          @db.Decimal(18, 4)
  reference   String?
  paidAt      DateTime         @default(now())
  createdById String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([method])
}

model WholesaleReturn {
  id              String                @id @default(cuid())
  /// Human return number (e.g. WSR-2026-000123)
  number          String                @unique
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  warehouseId     String
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  invoiceId       String
  invoice         WholesaleInvoice      @relation(fields: [invoiceId], references: [id])
  returnDate      DateTime              @default(now())
  refundAmount    Decimal               @default(0) @db.Decimal(18, 4)
  /// Whether refund was cash/bank or just reduced outstanding receivable
  refundToBalance Boolean               @default(true)
  refundMethod    PosPaymentMethod      @default(CASH)
  status          WholesaleReturnStatus @default(COMPLETED)
  reason          String?
  createdById     String?

  items WholesaleReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, returnDate])
  @@index([invoiceId])
}

model WholesaleReturnItem {
  id            String               @id @default(cuid())
  returnId      String
  return        WholesaleReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   WholesaleInvoiceItem @relation(fields: [invoiceItemId], references: [id])
  productId     String
  product       Product              @relation(fields: [productId], references: [id])
  quantity      Decimal              @db.Decimal(18, 4)
  unitPrice     Decimal              @db.Decimal(18, 4)
  lineTotal     Decimal              @db.Decimal(18, 4)

  @@index([returnId])
  @@index([invoiceItemId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Corporate Sales — B2B lifecycle: Quote → Order → Delivery → Invoice → Payment
// Stock decrements at delivery (not invoice). Customer ledger debits at invoice.
// ─────────────────────────────────────────────────────────────────────────────

enum CorporateQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum CorporateOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  INVOICED
  CLOSED
  CANCELED
}

enum CorporateDeliveryStatus {
  DRAFT
  APPROVED
  PICKING
  PACKED
  DISPATCHED
  DELIVERED
  CLOSED
  VOIDED
}

enum CorporateReturnStatus {
  REQUESTED
  APPROVED
  GOODS_RECEIVED
  QC_INSPECTION
  INVENTORY_UPDATED
  CREDIT_NOTE_ISSUED
  CLOSED
  REJECTED
}

enum ReturnCondition {
  RESALABLE
  REPAIRABLE
  DAMAGED
  MANUFACTURING_DEFECT
}

enum RefundType {
  CASH
  BANK
  CREDIT_NOTE
  REPLACEMENT
}

enum CorporateInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
}

model CorporateQuote {
  id            String               @id @default(cuid())
  number        String               @unique
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  salesRepId    String?
  quoteDate     DateTime             @default(now())
  validUntil    DateTime?
  currency      CurrencyCode         @default(BDT)
  subtotal      Decimal              @default(0) @db.Decimal(18, 4)
  discountTotal Decimal              @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal              @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal              @default(0) @db.Decimal(18, 4)
  status        CorporateQuoteStatus @default(DRAFT)
  notes         String?
  rejectReason  String?
  createdById   String?

  items  CorporateQuoteItem[]
  orders CorporateOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, quoteDate])
  @@index([customerId, quoteDate])
}

model CorporateQuoteItem {
  id           String         @id @default(cuid())
  quoteId      String
  quote        CorporateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  description  String?
  unit         UnitOfMeasure  @default(PCS)
  quantity     Decimal        @db.Decimal(18, 4)
  unitPrice    Decimal        @db.Decimal(18, 4)
  discountRate Decimal        @default(0) @db.Decimal(5, 2)
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal        @db.Decimal(18, 4)

  @@index([quoteId])
  @@index([productId])
}

model CorporateOrder {
  id            String               @id @default(cuid())
  number        String               @unique
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  warehouseId   String
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  customerId    String
  customer      Customer             @relation(fields: [customerId], references: [id])
  quoteId       String?
  quote         CorporateQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  salesRepId    String?
  orderDate     DateTime             @default(now())
  expectedDate  DateTime?
  paymentTerms  PaymentTerms         @default(NET_30)
  currency      CurrencyCode         @default(BDT)
  subtotal      Decimal              @default(0) @db.Decimal(18, 4)
  discountTotal Decimal              @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal              @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal              @default(0) @db.Decimal(18, 4)
  status        CorporateOrderStatus @default(DRAFT)
  notes         String?
  cancelReason  String?
  createdById   String?

  items      CorporateOrderItem[]
  deliveries CorporateDelivery[]
  invoices   CorporateInvoice[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  corporateSalesReturns CorporateSalesReturn[]

  @@index([branchId, status, orderDate])
  @@index([customerId, orderDate])
}

model CorporateOrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        CorporateOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  description  String?
  unit         UnitOfMeasure  @default(PCS)
  quantity     Decimal        @db.Decimal(18, 4)
  unitPrice    Decimal        @db.Decimal(18, 4)
  discountRate Decimal        @default(0) @db.Decimal(5, 2)
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal        @db.Decimal(18, 4)
  deliveredQty Decimal        @default(0) @db.Decimal(18, 4)
  invoicedQty  Decimal        @default(0) @db.Decimal(18, 4)

  deliveryItems             CorporateDeliveryItem[]
  invoiceItems              CorporateInvoiceItem[]
  corporateSalesReturnItems CorporateSalesReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model CorporateDelivery {
  id              String                  @id @default(cuid())
  number          String                  @unique // Delivery Challan No
  branchId        String
  branch          Branch                  @relation(fields: [branchId], references: [id])
  warehouseId     String
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id])
  orderId         String
  order           CorporateOrder          @relation(fields: [orderId], references: [id])
  deliveryAddress String?                 @db.VarChar(500)
  expectedDate    DateTime?               @db.Date
  deliveryDate    DateTime?
  status          CorporateDeliveryStatus @default(DRAFT)

  // Logistics
  vehicleNo        String?
  driverName       String?
  driverPhone      String?
  transportCompany String?
  trackingNo       String?
  gatePassNo       String?

  // POD
  receivedById      String?
  receivedBy        User?   @relation("DeliveryReceivedBy", fields: [receivedById], references: [id])
  customerSignature String?
  podAttachment     String?

  notes       String?
  createdById String?

  items CorporateDeliveryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, deliveryDate])
  @@index([orderId])
}

model CorporateDeliveryItem {
  id          String             @id @default(cuid())
  deliveryId  String
  delivery    CorporateDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   CorporateOrderItem @relation(fields: [orderItemId], references: [id])
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  quantity    Decimal            @db.Decimal(18, 4)

  @@index([deliveryId])
  @@index([orderItemId])
  @@index([productId])
}

model CorporateSalesReturn {
  id          String                @id @default(cuid())
  returnNo    String                @unique
  branchId    String
  branch      Branch                @relation(fields: [branchId], references: [id])
  customerId  String
  customer    Customer              @relation(fields: [customerId], references: [id])
  orderId     String
  order       CorporateOrder        @relation(fields: [orderId], references: [id])
  invoiceId   String?
  invoice     CorporateInvoice?     @relation(fields: [invoiceId], references: [id])
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  returnDate  DateTime              @default(now())
  status      CorporateReturnStatus @default(REQUESTED)

  refundType RefundType @default(CREDIT_NOTE)

  reason String?
  notes  String?

  qcOfficerId String?
  qcOfficer   User?   @relation("ReturnQcOfficer", fields: [qcOfficerId], references: [id])

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CorporateSalesReturnItem[]

  @@index([branchId, returnDate])
  @@index([orderId])
}

model CorporateSalesReturnItem {
  id          String               @id @default(cuid())
  returnId    String
  salesReturn CorporateSalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   CorporateOrderItem   @relation(fields: [orderItemId], references: [id])
  productId   String
  product     Product              @relation(fields: [productId], references: [id])

  batchNo     String?
  soldQty     Decimal @db.Decimal(18, 4)
  returnedQty Decimal @db.Decimal(18, 4)

  condition        ReturnCondition @default(RESALABLE)
  inspectionResult String?
  damageType       String?
  photoAttachment  String?

  @@index([returnId])
  @@index([productId])
}

model CorporateInvoice {
  id            String                 @id @default(cuid())
  number        String                 @unique
  branchId      String
  branch        Branch                 @relation(fields: [branchId], references: [id])
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  orderId       String
  order         CorporateOrder         @relation(fields: [orderId], references: [id])
  invoiceDate   DateTime               @default(now())
  dueDate       DateTime?
  currency      CurrencyCode           @default(BDT)
  subtotal      Decimal                @default(0) @db.Decimal(18, 4)
  discountTotal Decimal                @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal                @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal                @default(0) @db.Decimal(18, 4)
  paidTotal     Decimal                @default(0) @db.Decimal(18, 4)
  balanceDue    Decimal                @default(0) @db.Decimal(18, 4)
  status        CorporateInvoiceStatus @default(ISSUED)
  notes         String?
  createdById   String?

  items    CorporateInvoiceItem[]
  payments CorporateInvoicePayment[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  corporateSalesReturns CorporateSalesReturn[]

  @@index([branchId, status, invoiceDate])
  @@index([customerId, invoiceDate])
  @@index([orderId])
  @@index([dueDate])
}

model CorporateInvoiceItem {
  id           String             @id @default(cuid())
  invoiceId    String
  invoice      CorporateInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    CorporateOrderItem @relation(fields: [orderItemId], references: [id])
  productId    String
  product      Product            @relation(fields: [productId], references: [id])
  description  String?
  colorDesign  String?
  quantity     Decimal            @db.Decimal(18, 4)
  unitPrice    Decimal            @db.Decimal(18, 4)
  discountRate Decimal            @default(0) @db.Decimal(5, 2)
  taxRate      Decimal            @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal            @db.Decimal(18, 4)

  @@index([invoiceId])
  @@index([orderItemId])
}

model CorporateInvoicePayment {
  id          String           @id @default(cuid())
  invoiceId   String
  invoice     CorporateInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      PosPaymentMethod
  amount      Decimal          @db.Decimal(18, 4)
  reference   String?
  paidAt      DateTime         @default(now())
  createdById String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([method])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chart of Accounts (Module 14) — adjacency list + materialized path
// ─────────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountNormalSide {
  DEBIT
  CREDIT
}

model ChartAccount {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  type               AccountType
  normalSide         AccountNormalSide
  parentId           String?
  parent             ChartAccount?     @relation("AccountTree", fields: [parentId], references: [id])
  children           ChartAccount[]    @relation("AccountTree")
  path               String
  depth              Int               @default(0)
  isPosting          Boolean           @default(true)
  isControl          Boolean           @default(false)
  currency           CurrencyCode      @default(BDT)
  branchId           String?
  branch             Branch?           @relation(fields: [branchId], references: [id])
  openingBalance     Decimal           @default(0) @db.Decimal(18, 4)
  description        String?
  isActive           Boolean           @default(true)
  detailType         String?
  openingBalanceDate DateTime?
  isSystem           Boolean           @default(false)

  journalLines          JournalEntryLine[]
  systemMappings        SystemAccountMapping[]
  openingBalanceEntries OpeningBalanceEntry[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([parentId])
  @@index([path])
  @@index([branchId])
  @@index([isActive])
}

model OpeningBalanceEntry {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  periodId      String?
  period        Period?           @relation(fields: [periodId], references: [id], onDelete: SetNull)
  accountId     String
  account       ChartAccount      @relation(fields: [accountId], references: [id])
  date          DateTime
  amount        Decimal           @db.Decimal(18, 4)
  normalSide    AccountNormalSide
  reference     String?
  remarks       String?
  sourceRefType String?
  sourceRefId   String?
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, date])
  @@index([periodId])
  @@index([accountId, date])
  @@index([sourceRefType, sourceRefId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Accounts & Finance (Module 13) — Journal entries, system account mappings
// ─────────────────────────────────────────────────────────────────────────────

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum SystemAccountKey {
  CASH
  BANK_DEFAULT
  AR_CONTROL
  AP_CONTROL
  INVENTORY
  INVENTORY_RAW_MATERIAL
  INVENTORY_FINISHED_GOODS
  WIP
  COGS
  SALES_REVENUE
  SALES_REVENUE_POS
  SALES_REVENUE_WHOLESALE
  SALES_REVENUE_CORPORATE
  SALES_RETURNS
  DISCOUNT_GIVEN
  TAX_PAYABLE
