  advanceDeduction            Decimal @default(0) @db.Decimal(18, 2)
  lateDeduction               Decimal @default(0) @db.Decimal(18, 2)
  absentDeduction             Decimal @default(0) @db.Decimal(18, 2)
  payrollAdjustmentsDeduction Decimal @default(0) @db.Decimal(18, 2)
  otherDeduction              Decimal @default(0) @db.Decimal(18, 2)

  gross Decimal @db.Decimal(18, 2)
  net   Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Trade / Export-Import
// ─────────────────────────────────────────────────────────────────────────────

model TradeOrder {
  id       String @id @default(cuid())
  number   String @unique
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  type   TradeOrderType
  status TradeOrderStatus @default(DRAFT)

  // Counter-party — for EXPORT: customer; for IMPORT: supplier (one of these is set)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Contract / order basics
  contractRef  String?
  currency     CurrencyCode @default(USD)
  totalValue   Decimal      @default(0) @db.Decimal(18, 4)
  exchangeRate Decimal      @default(1) @db.Decimal(18, 6)
  localValue   Decimal      @default(0) @db.Decimal(18, 4)

  // Ports / incoterms
  portOfLoading   String?
  portOfDischarge String?
  incoterms       String? // FOB, CIF, EXW, etc.
  latestShipDate  DateTime? @db.Date
  expectedArrival DateTime? @db.Date

  // Goods description
  goodsDescription String?

  notes String?

  items     TradeOrderItem[]
  shipments TradeShipment[]
  lc        LetterOfCredit?
  payments  TradePayment[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, status])
  @@index([branchId, type])
  @@index([createdAt])
}

model TradeOrderItem {
  id           String     @id @default(cuid())
  tradeOrderId String
  tradeOrder   TradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  hsCode      String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String   @default("PCS")
  unitPrice   Decimal  @db.Decimal(18, 4)
  lineTotal   Decimal  @db.Decimal(18, 4)

  @@index([tradeOrderId])
}

model TradeShipment {
  id           String              @id @default(cuid())
  tradeOrderId String
  tradeOrder   TradeOrder          @relation(fields: [tradeOrderId], references: [id], onDelete: Restrict)
  status       TradeShipmentStatus @default(PENDING)
  sequence     Int                 @default(1)

  // Carrier / vessel info
  carrierName  String?
  vesselName   String?
  voyageNumber String?
  blNumber     String? // Bill of Lading number
  blDate       DateTime? @db.Date
  bookingRef   String?

  portOfLoading   String?
  portOfDischarge String?
  etd             DateTime? @db.Date // estimated departure
  eta             DateTime? @db.Date // estimated arrival
  actualDeparture DateTime? @db.Date
  actualArrival   DateTime? @db.Date

  containerNumbers String? // comma-separated if multiple
  sealNumbers      String?
  grossWeight      Decimal? @db.Decimal(18, 4)
  netWeight        Decimal? @db.Decimal(18, 4)
  volume           Decimal? @db.Decimal(18, 4)
  packages         Int?

  freightCost   Decimal? @db.Decimal(18, 4)
  insuranceCost Decimal? @db.Decimal(18, 4)

  notes            String?
  customsClearedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tradeOrderId, status])
}

model LetterOfCredit {
  id           String     @id @default(cuid())
  number       String     @unique
  tradeOrderId String     @unique
  tradeOrder   TradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])

  type        LCType        @default(SIGHT)
  status      LCStatus      @default(DRAFT)
  paymentMode LCPaymentMode @default(AT_SIGHT)

  // Parties
  applicantName     String // importer / buyer name
  beneficiaryName   String // exporter / seller name
  issuingBank       String
  issuingBankSwift  String?
  advisingBank      String?
  advisingBankSwift String?
  confirmingBank    String?

  // Amounts
  currency        CurrencyCode @default(USD)
  lcAmount        Decimal      @db.Decimal(18, 4)
  tolerancePlus   Decimal      @default(0) @db.Decimal(5, 2) // % above allowed
  toleranceMinus  Decimal      @default(0) @db.Decimal(5, 2) // % below allowed
  utilizedAmount  Decimal      @default(0) @db.Decimal(18, 4)
  availableAmount Decimal      @default(0) @db.Decimal(18, 4)

  // Dates
  issueDate        DateTime  @db.Date
  expiryDate       DateTime  @db.Date
  expiryPlace      String?
  latestShipDate   DateTime? @db.Date
  presentationDays Int       @default(21) // days after BL date for doc presentation

  // Terms
  partialShipment      Boolean @default(false)
  transhipmentAllowed  Boolean @default(false)
  portOfLoading        String?
  portOfDischarge      String?
  airPortOfLoading     String?
  airPortOfDestination String?
  flightNumber         String?
  airlineName          String?
  shipPortOfLoading    String?
  shipPortOfDischarge  String?
  vesselName           String?
  voyageNumber         String?
  goodsDescription     String?
  specialConditions    String?

  // SWIFT reference
  swiftMt700Ref String?

  amendments LCAmendment[]
  drawdowns  LCDrawdown[]

  issuedById  String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, status])
  @@index([expiryDate])
}

model LCAmendment {
  id   String         @id @default(cuid())
  lcId String
  lc   LetterOfCredit @relation(fields: [lcId], references: [id], onDelete: Restrict)

  amendmentNumber Int
  status          ApprovalStatus @default(PENDING)

  // Fields that can be amended (null = unchanged)
  newExpiryDate        DateTime? @db.Date
  newLcAmount          Decimal?  @db.Decimal(18, 4)
  newLatestShipDate    DateTime? @db.Date
  newSpecialConditions String?

  reason        String
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectionNote String?

  swiftMt707Ref String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lcId, amendmentNumber])
  @@index([lcId, status])
}

model LCDrawdown {
  id   String         @id @default(cuid())
  lcId String
  lc   LetterOfCredit @relation(fields: [lcId], references: [id], onDelete: Restrict)

  drawdownNumber Int
  status         LCDrawdownStatus @default(DRAFT)

  // Presentation
  presentationDate DateTime  @db.Date
  documentsDueBy   DateTime? @db.Date
  amount           Decimal   @db.Decimal(18, 4)

  // Documents presented
  commercialInvoiceRef String?
  blRef                String?
  packingListRef       String?
  certificateOfOrigin  Boolean @default(false)
  inspectionCert       Boolean @default(false)
  otherDocs            String?

  // Settlement
  paymentDueDate    DateTime? @db.Date
  paymentReceivedAt DateTime? @db.Date
  bankCharges       Decimal   @default(0) @db.Decimal(18, 4)
  notes             String?

  discrepancyNote String?
  rejectionReason String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lcId, drawdownNumber])
  @@index([lcId, status])
}

model TradePayment {
  id           String     @id @default(cuid())
  number       String     @unique
  tradeOrderId String
  tradeOrder   TradeOrder @relation(fields: [tradeOrderId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id])

  status TradePaymentStatus @default(PENDING)

  currency     CurrencyCode @default(USD)
  amount       Decimal      @db.Decimal(18, 4)
  exchangeRate Decimal      @db.Decimal(18, 6)
  localAmount  Decimal      @db.Decimal(18, 4)

  bankName      String?
  bankReference String?
  swiftRef      String?
  paymentDate   DateTime? @db.Date
  valueDate     DateTime? @db.Date

  notes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tradeOrderId])
  @@index([branchId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cash Transfer (branch-to-branch)
// ─────────────────────────────────────────────────────────────────────────────

enum CashTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model CashTransfer {
  id           String             @id @default(cuid())
  number       String             @unique
  fromBranchId String
  fromBranch   Branch             @relation("CashTransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch             @relation("CashTransferTo", fields: [toBranchId], references: [id])
  amount       Decimal            @db.Decimal(18, 4)
  transferDate DateTime           @default(now())
  transferVia  String?
  reference    String?
  remarks      String
  imageUrl     String?
  status       CashTransferStatus @default(PENDING)
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromBranchId, transferDate])
  @@index([toBranchId, transferDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cash Entries (manual cash in / cash out vouchers)
// ─────────────────────────────────────────────────────────────────────────────

enum CashEntryType {
  CASH_IN
  CASH_OUT
}

model CashEntry {
  id          String        @id @default(cuid())
  number      String        @unique
  type        CashEntryType
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  date        DateTime      @default(now())
  amount      Decimal       @db.Decimal(18, 4)
  taxPercent  Decimal?      @db.Decimal(5, 2)
  taxAmount   Decimal?      @db.Decimal(18, 4)
  totalAmount Decimal       @db.Decimal(18, 4)

  contactId   String?
  contact     Customer? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName String?
  contactType String?

  receiveMode String
  category    String
  reference   String?
  projectName String?
  remarks     String?
  imageUrl    String?

  sourceModule  String?
  sourceRefType String?
  sourceRefId   String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, date])
  @@index([type, branchId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Salary Components
// ─────────────────────────────────────────────────────────────────────────────

enum SalaryComponentCategory {
  EARNINGS
  DEDUCTION
}

enum SalaryComponentType {
  FIXED
  VARIABLE
}

enum SalaryCalculationType {
  FIXED_AMOUNT
  PERCENTAGE
  FORMULA
  MANUAL_ENTRY
}

enum SalaryComponentStatus {
  ACTIVE
  INACTIVE
}

model SalaryComponent {
  id              String                  @id @default(cuid())
  name            String
  code            String                  @unique
  description     String?
  category        SalaryComponentCategory
  type            SalaryComponentType
  calculationType SalaryCalculationType
  value           Decimal?                @db.Decimal(18, 4) // Fixed amount or percentage
  formula         String?
  baseComponent   String? // e.g., 'BASIC', 'GROSS'

  isTaxable         Boolean @default(true)
  includeInGross    Boolean @default(true)
  includeInNet      Boolean @default(true)
  showInPayslip     Boolean @default(true)
  isSystemGenerated Boolean @default(false)

  isMandatory             Boolean  @default(false)
  isEditableDuringPayroll Boolean  @default(false)
  allowNegativeValue      Boolean  @default(false)
  maxAmount               Decimal? @db.Decimal(18, 4)
  minAmount               Decimal? @db.Decimal(18, 4)

  status SalaryComponentStatus @default(ACTIVE)

  applicableEmploymentTypes String[]
  applicableDepartments     String[]
  applicableDesignations    String[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  salaryStructureComponents SalaryStructureComponent[]

  @@index([category])
  @@index([type])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Salary Structure
// ─────────────────────────────────────────────────────────────────────────────

enum PayrollFrequency {
  MONTHLY
  WEEKLY
  DAILY
  HOURLY
}

enum SalaryStructureStatus {
  ACTIVE
  INACTIVE
}

model SalaryStructure {
  id          String                @id @default(cuid())
  name        String
  code        String                @unique
  description String?
  status      SalaryStructureStatus @default(ACTIVE)

  grossSalary Decimal  @db.Decimal(18, 4)
  netSalary   Decimal? @db.Decimal(18, 4)

  effectiveFrom    DateTime         @db.Date
  effectiveTo      DateTime?        @db.Date
  payrollFrequency PayrollFrequency @default(MONTHLY)
  currency         CurrencyCode     @default(BDT)

  employmentTypes String[]
  departmentIds   String[]
  designationIds  String[]
  branchIds       String[]

  notes String?

  components          SalaryStructureComponent[]
  employeeAssignments EmployeeSalaryStructureAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SalaryStructureComponent {
  id                String          @id @default(cuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryComponentId String
  salaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  value            Decimal @db.Decimal(18, 4)
  isAutoCalculated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaryStructureId, salaryComponentId])
}

model EmployeeSalaryStructureAssignment {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)
  effectiveFrom     DateTime        @db.Date
  effectiveTo       DateTime?       @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([salaryStructureId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payroll Period
// ─────────────────────────────────────────────────────────────────────────────

enum PayrollPeriodStatus {
  DRAFT
  OPEN
  CLOSED
}

model PayrollPeriod {
  id    String @id @default(cuid())
  name  String
  code  String @unique
  month Int
  year  Int

  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  processingDate DateTime? @db.Date
  paymentDate    DateTime? @db.Date

  attendanceCutoffDate DateTime? @db.Date
  overtimeCutoffDate   DateTime? @db.Date
  leaveCutoffDate      DateTime? @db.Date

  includeAttendance    Boolean @default(true)
  includeLeave         Boolean @default(true)
  includeOvertime      Boolean @default(true)
  includeBonus         Boolean @default(true)
  includeLoanDeduction Boolean @default(true)
  includeSalaryAdvance Boolean @default(true)
  includeTax           Boolean @default(true)

  allowReprocessing       Boolean @default(false)
  autoCloseAfterPayroll   Boolean @default(true)
  lockPayrollAfterClosing Boolean @default(true)

  status PayrollPeriodStatus @default(DRAFT)

  payrollRuns        PayrollRun[]
  payrollAdjustments PayrollAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Loans & Advances
// ─────────────────────────────────────────────────────────────────────────────

enum LoanType {
  EMPLOYEE_LOAN
  SALARY_ADVANCE
}

enum LoanPurpose {
  MEDICAL
  EDUCATION
  EMERGENCY
  PERSONAL
  FESTIVAL
  HOUSE_RENT
  OTHERS
}

enum LoanInstallmentType {
  MONTHLY
  ONE_TIME
}

enum LoanStatus {
  DRAFT
  SUBMITTED
  PENDING_HR
  PENDING_ACCOUNTS
  PENDING_MANAGEMENT
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  REJECTED
  CLOSED
}

model LoanRequest {
  id          String   @id @default(cuid())
  referenceNo String   @unique
  requestType LoanType @default(EMPLOYEE_LOAN)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  loanAmount          Decimal     @db.Decimal(18, 4)
  purpose             LoanPurpose
  disbursementDate    DateTime    @db.Date
  repaymentStartMonth String // YYYY-MM

  installmentType      LoanInstallmentType @default(MONTHLY)
  numberOfInstallments Int                 @default(1)
  monthlyDeduction     Decimal             @db.Decimal(18, 4)

  outstandingBalance Decimal @default(0) @db.Decimal(18, 4)
  paidAmount         Decimal @default(0) @db.Decimal(18, 4)

  remarks String?

  status LoanStatus @default(DRAFT)

  hrApprovalStatus     String?
  accountsVerification String?
  managementDecision   String?

  repaymentSchedules LoanRepaymentSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([requestType])
}

enum RepaymentStatus {
  PENDING
  PAID
  SKIPPED
}

model LoanRepaymentSchedule {
  id            String      @id @default(cuid())
  loanRequestId String
  loanRequest   LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)

  payrollMonth     String // YYYY-MM
  installment      Decimal @db.Decimal(18, 4)
  remainingBalance Decimal @db.Decimal(18, 4)

  status       RepaymentStatus @default(PENDING)
  payrollRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loanRequestId])
  @@index([payrollMonth])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bonus
// ─────────────────────────────────────────────────────────────────────────────

enum BonusType {
  FESTIVAL
  ATTENDANCE
  PRODUCTION
  PERFORMANCE
  SALES_INCENTIVE
  SPECIAL
  YEARLY
  JOINING
  RETENTION
  OTHER
}

enum BonusCalculationMethod {
  FIXED_AMOUNT
  PERCENTAGE
  FORMULA
}

enum BonusBasedOn {
  BASIC_SALARY
  GROSS_SALARY
  NET_SALARY
}

enum BonusStatus {
  DRAFT
  SUBMITTED
  PENDING_HR
  PENDING_MANAGEMENT
  APPROVED
  PUBLISHED
  PAID
  REJECTED
  CLOSED
}

enum BonusPaymentMethod {
  PAYROLL
  CASH
  BANK_TRANSFER
}

model Bonus {
  id                    String    @id @default(cuid())
  name                  String
  code                  String    @unique
  bonusType             BonusType @default(FESTIVAL)
  effectivePayrollMonth String // YYYY-MM
  description           String?

  calculationMethod BonusCalculationMethod @default(FIXED_AMOUNT)
  amount            Decimal?               @db.Decimal(18, 4)
  percentage        Decimal?               @db.Decimal(18, 4)
  basedOn           BonusBasedOn?

  minimumServiceMonths Int @default(0)

  paymentMethod    BonusPaymentMethod @default(PAYROLL)
  paymentDate      DateTime?          @db.Date
  includeInPayslip Boolean            @default(true)

  status BonusStatus @default(DRAFT)

  hrApprovalStatus   String?
  managementDecision String?
  remarks            String?

  employeeBonuses EmployeeBonus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([effectivePayrollMonth])
  @@index([status])
}

model EmployeeBonus {
  id      String @id @default(cuid())
  bonusId String
  bonus   Bonus  @relation(fields: [bonusId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  amount Decimal @db.Decimal(18, 4)

  payrollRunId String?
  isPaid       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bonusId, employeeId])
  @@index([employeeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payroll Adjustment
// ─────────────────────────────────────────────────────────────────────────────

enum PayrollAdjustmentType {
  ALLOWANCE
  DEDUCTION
  BONUS_CORRECTION
  SALARY_CORRECTION
  TAX_ADJUSTMENT
  OVERTIME_ADJUSTMENT
  ATTENDANCE_ADJUSTMENT
  LOAN_ADJUSTMENT
  ADVANCE_ADJUSTMENT
  OTHER
}

enum PayrollAdjustmentCategory {
  ONE_TIME
  RECURRING
}

enum PayrollAdjustmentReason {
  ATTENDANCE_CORRECTION
  MANUAL_BONUS
  LATE_SALARY_REVISION
  OT_CORRECTION
  RECOVERY
  OTHER
}

enum PayrollAdjustmentStatus {
  DRAFT
  SUBMITTED
  PENDING_HR
  PENDING_MANAGEMENT
  APPROVED
  APPLIED
  COMPLETED
  REJECTED
  CLOSED
}

model PayrollAdjustment {
  id String @id @default(cuid())
  no String @unique

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  adjustmentDate DateTime @db.Date

  type        PayrollAdjustmentType
  category    PayrollAdjustmentCategory @default(ONE_TIME)
  amount      Decimal                   @db.Decimal(18, 4)
  description String?

  includeInGrossSalary Boolean @default(true)
  includeInTax         Boolean @default(false)
  includeInPayslip     Boolean @default(true)

  reason  PayrollAdjustmentReason
  remarks String?

  status PayrollAdjustmentStatus @default(DRAFT)

  hrDecision         String?
  managementDecision String?

  payrollRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Final Settlement
// ─────────────────────────────────────────────────────────────────────────────

enum FinalSettlementStatus {
  DRAFT
  CALCULATED
  PENDING_HR
  PENDING_FINANCE
  PENDING_MANAGEMENT
  APPROVED
  PAID
  CLOSED
  REJECTED
}

model FinalSettlement {
  id String @id @default(cuid())
  no String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  resignationId String?              @unique
  resignation   EmployeeResignation? @relation(fields: [resignationId], references: [id])

  separationType  String
  lastWorkingDate DateTime @db.Date
  reason          String?

  // Earnings
  pendingSalary   Decimal @default(0) @db.Decimal(18, 2)
  leaveEncashment Decimal @default(0) @db.Decimal(18, 2)
  overtimeAmount  Decimal @default(0) @db.Decimal(18, 2)
  bonusAmount     Decimal @default(0) @db.Decimal(18, 2)
  otherEarnings   Decimal @default(0) @db.Decimal(18, 2)
  totalEarnings   Decimal @default(0) @db.Decimal(18, 2)

  // Deductions
  loanRecovery      Decimal @default(0) @db.Decimal(18, 2)
  advanceRecovery   Decimal @default(0) @db.Decimal(18, 2)
  incomeTax         Decimal @default(0) @db.Decimal(18, 2)
  noticePayRecovery Decimal @default(0) @db.Decimal(18, 2)
  assetRecovery     Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions   Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions   Decimal @default(0) @db.Decimal(18, 2)

  // Net
  netSettlement Decimal @default(0) @db.Decimal(18, 2)

  // Approvals & Status
  status             FinalSettlementStatus @default(DRAFT)
  hrApproval         String?
  financeApproval    String?
  managementApproval String?
  remarks            String?

  // Payment
  paymentMethod  String?
  paymentDate    DateTime?
  transactionRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Announcements
// ─────────────────────────────────────────────────────────────────────────────

enum AnnouncementAudience {
  ALL
  BRANCH
  DEPARTMENT
  USER
}

/// Broadcast messages from a superadmin to all users, one branch, one
/// department (a free-text value already in use on Employee.department —
/// there's no normalized Department model in this schema), or one specific
/// user. Delivery/read-tracking deliberately reuses the existing
/// Notification model (one row fanned out per targeted recipient) rather
/// than a parallel receipt table — an announcement is just a notification
/// with a real, always-visible source record and optional attachments
/// (via the existing polymorphic DocumentLink, entityType "Announcement").
model Announcement {
  id      String @id @default(cuid())
  title   String
  body    String

  audienceType       AnnouncementAudience @default(ALL)
  audienceBranchId   String?
  audienceBranch     Branch?              @relation("AnnouncementAudienceBranch", fields: [audienceBranchId], references: [id], onDelete: SetNull)
  audienceDepartment String?
  audienceUserId     String?
  audienceUser       User?                @relation("AnnouncementAudienceUser", fields: [audienceUserId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("AnnouncementAuthor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audienceType, createdAt])
  @@index([createdById])
}
