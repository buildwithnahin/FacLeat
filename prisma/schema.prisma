// ─────────────────────────────────────────────────────────────────────────────
// Identity & RBAC
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  employeeId       String?          @unique
  employee         Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  email            String           @unique
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  status           UserStatus       @default(ACTIVE)
  branchAccessType BranchAccessType @default(OWN_BRANCH_ONLY)
  defaultBranchId  String?
  defaultBranch    Branch?          @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  defaultCompanyId String?
  defaultCompany   Company?         @relation("UserDefaultCompany", fields: [defaultCompanyId], references: [id])

  roles              UserRole[]
  branchAccesses     UserBranchAccess[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  notifications      Notification[]       @relation("NotificationRecipient")
  mobileRefreshTokens MobileRefreshToken[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  attendanceExceptions AttendanceException[]

  issueRequests    ProductionIssueVoucher[]      @relation("IssueRequestedBy")
  issueApprovals   ProductionIssueVoucher[]      @relation("IssueApprovedBy")
  issuesIssued     ProductionIssueVoucher[]      @relation("IssueIssuedBy")
  fgReceives       FinishedGoodsReceiveVoucher[] @relation("FgReceivedBy")
  fgApprovals      FinishedGoodsReceiveVoucher[] @relation("FgApprovedBy")
  qcOfficerReturns CorporateSalesReturn[]        @relation("ReturnQcOfficer")
  deliveryReceives CorporateDelivery[]           @relation("DeliveryReceivedBy")
  productionPlans  ProductionPlan[]              @relation("PlannerRelation")

  announcementsAuthored  Announcement[] @relation("AnnouncementAuthor")
  announcementAudiences  Announcement[] @relation("AnnouncementAudienceUser")

  @@index([status])
}

/// Refresh tokens for the Super-Admin-only mobile app (JWT access + rotating
/// refresh pair). The raw token is never stored — only its SHA-256 hash.
model MobileRefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String  @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean @default(false)

  users       UserRole[]
  employees   Employee[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id     String @id @default(cuid())
  /// "<module>:<action>" — see src/lib/permissions.ts
  key    String @unique
  module String
  action String

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model UserBranchAccess {
  userId     String
  branchId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-branch
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code               String       @unique
  name               String
  type               String       @default("MAIN") // MAIN / FACTORY / SHOWROOM / WAREHOUSE
  currency           CurrencyCode @default(BDT)
  address            String?
  phone              String?
  email              String?
  allowNegativeStock Boolean      @default(false)
  isActive           Boolean      @default(true)
  vatNumber          String? // BIN for Mushak 6.3

  defaultForUsers             User[]                       @relation("UserDefaultBranch")
  userBranchAccesses          UserBranchAccess[]
  periods                     Period[]
  auditLogs                   AuditLog[]
  notifications               Notification[]
  warehouses                  Warehouse[]
  ledger                      InventoryLedger[]
  customerReturns             CustomerReturn[]
  damageReports               DamageReport[]
  suppliers                   Supplier[]
  requisitions                PurchaseRequisition[]
  stockRequisitions           StockRequisition[]
  purchaseOrders              PurchaseOrder[]
  grns                        GoodsReceiving[]
  purchaseInvoices            PurchaseInvoice[]
  supplierPayments            SupplierPayment[]
  supplierLedger              SupplierLedger[]
  productionOrders            ProductionOrder[]
  assets                      Asset[]
  assetMovements              AssetMovement[]
  customers                   Customer[]
  customerLedger              CustomerLedger[]
  posSessions                 PosSession[]
  posSales                    PosSale[]
  posReturns                  PosReturn[]
  wholesaleInvoices           WholesaleInvoice[]
  wholesaleReturns            WholesaleReturn[]
  corporateQuotes             CorporateQuote[]
  corporateOrders             CorporateOrder[]
  corporateDeliveries         CorporateDelivery[]
  corporateInvoices           CorporateInvoice[]
  chartAccounts               ChartAccount[]
  journalEntries              JournalEntry[]
  employees                   Employee[]
  shifts                      Shift[]
  holidays                    Holiday[]
  hrMasterData                HrMasterData[]
  hrWorkflowRecords           HrWorkflowRecord[]
  payrollRuns                 PayrollRun[]
  tradeOrders                 TradeOrder[]
  lettersOfCredit             LetterOfCredit[]
  tradePayments               TradePayment[]
  contracts                   Contract[]
  ecommerceChannels           EcommerceChannel[]
  ecommerceOrders             EcommerceOrder[]
  ecommerceFulfillments       EcommerceFulfillment[]
  ecommercePayments           EcommercePayment[]
  ecommerceReturns            EcommerceReturn[]
  ecommerceReconciliationRuns EcommerceReconciliationRun[]

  cashTransfersSent             CashTransfer[]            @relation("CashTransferFrom")
  cashTransfersReceived         CashTransfer[]            @relation("CashTransferTo")
  cashEntries                   CashEntry[]
  openingBalanceEntries         OpeningBalanceEntry[]
  employeePromotions            EmployeePromotion[]
  employeeIncrements            EmployeeIncrement[]
  employeeConfirmations         EmployeeConfirmation[]
  employeeResignations          EmployeeResignation[]
  employeeExitClearances        EmployeeExitClearance[]
  attendanceAdjustments         AttendanceAdjustment[]
  overtimeRecords               OvertimeRecord[]
  attendanceSummaryRecords      AttendanceSummaryRecord[]
  employeeSalaryHistory         EmployeeSalaryHistory[]
  employeeTransfers             EmployeeTransfer[]
  employeeTransfersToNewBranch  EmployeeTransfer[]        @relation("TransferNewBranch")
  employeeTransfersToTempBranch EmployeeTransfer[]        @relation("TransferTempBranch")
  leavePolicies                 LeavePolicy[]
  leaveTypes                    LeaveType[]

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  attendanceRules              AttendanceRule[]
  productionIssueVouchers      ProductionIssueVoucher[]
  processTrackings             ProcessTracking[]
  wipLedgers                   WipLedger[]
  scrapLedgers                 ScrapLedger[]
  finishedGoodsReceiveVouchers FinishedGoodsReceiveVoucher[]
  corporateSalesReturns        CorporateSalesReturn[]
  debitNotes                   DebitNote[]
  productionPlans              ProductionPlan[]
  outboundStockTransfers       StockTransfer[]               @relation("StockTransferFromBranch")
  inboundStockTransfers        StockTransfer[]               @relation("StockTransferToBranch")

  announcementAudiences Announcement[] @relation("AnnouncementAudienceBranch")

  @@index([isActive])
  @@index([companyId])
}

model Company {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  address  String?
  phone    String?
  email    String?
  currency CurrencyCode @default(BDT)
  isActive Boolean      @default(true)

  branches           Branch[]
  products           Product[]
  productCategories  ProductCategory[]
  productBrands      ProductBrand[]
  assetCategories    AssetCategory[]
  customerCategories CustomerCategory[]
  defaultForUsers    User[]             @relation("UserDefaultCompany")
  roles              Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fiscal period lock (used by accounts + inventory stock freeze)
// ─────────────────────────────────────────────────────────────────────────────

model Period {
  id       String       @id @default(cuid())
  branchId String
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name     String // e.g. "FY2025-26 Apr"
  startsAt DateTime
  endsAt   DateTime
  status   PeriodStatus @default(OPEN)

  journalEntries        JournalEntry[]
  openingBalanceEntries OpeningBalanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([branchId, status])
  @@index([startsAt, endsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log (append-only; no update/delete in app code)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id])
  branchId   String?
  branch     Branch? @relation(fields: [branchId], references: [id])
  module     String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@index([branchId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications (SSE-delivered in Phase 1)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  recipientId String
  recipient   User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?              @relation(fields: [branchId], references: [id])
  severity    NotificationSeverity @default(INFO)
  module      String
  title       String
  body        String?
  href        String?
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([module])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product master
// ─────────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([parentId])
  @@index([companyId])
}

model ProductBrand {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Product {
  id                        String                     @id @default(cuid())
  companyId                 String
  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sku                       String
  barcode                   String?
  name                      String
  description               String?
  size                      String?
  type                      ProductType                @default(FINISHED_GOOD)
  unit                      UnitOfMeasure              @default(PCS)
  categoryId                String?
  category                  ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId                   String?
  brand                     ProductBrand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  costPrice                 Decimal                    @default(0) @db.Decimal(18, 4)
  sellPrice                 Decimal                    @default(0) @db.Decimal(18, 4)
  taxRate                   Decimal                    @default(15) @db.Decimal(5, 2)
  reorderLevel              Decimal                    @default(0) @db.Decimal(18, 4)
  reorderQty                Decimal                    @default(0) @db.Decimal(18, 4)
  isActive                  Boolean                    @default(true)
  imageUrl                  String?
  ledger                    InventoryLedger[]
  customerReturnItems       CustomerReturnItem[]
  damageReportItems         DamageReportItem[]
  requisitionItems          PurchaseRequisitionItem[]
  stockRequisitionItems     StockRequisitionItem[]
  purchaseOrderItems        PurchaseOrderItem[]
  grnItems                  GoodsReceivingItem[]
  invoiceItems              PurchaseInvoiceItem[]
  producedInOrders          ProductionOrder[]          @relation("ProductionOutputProduct")
  materialsOfOrders         ProductionMaterial[]
  outputsOfOrders           ProductionOutput[]
  posSaleItems              PosSaleItem[]
  posReturnItems            PosReturnItem[]
  wholesaleItems            WholesaleInvoiceItem[]
  wholesaleReturns          WholesaleReturnItem[]
  corpQuoteItems            CorporateQuoteItem[]
  corpOrderItems            CorporateOrderItem[]
  corpDeliveryItems         CorporateDeliveryItem[]
  corpInvoiceItems          CorporateInvoiceItem[]
  tradeOrderItems           TradeOrderItem[]
  ecommerceOrderItems       EcommerceOrderItem[]
  ecommerceFulfillmentItems EcommerceFulfillmentItem[]
  ecommerceReturnItems      EcommerceReturnItem[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  productionIssueItems      ProductionIssueItem[]
  processTrackings          ProcessTracking[]
  wipLedgers                WipLedger[]
  finishedGoodsReceiveItems FinishedGoodsReceiveItem[]
  corporateSalesReturnItems CorporateSalesReturnItem[]
  debitNoteItems            DebitNoteItem[]
  productionPlans           ProductionPlan[]
  stockTransferItems        StockTransferItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([name])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Warehouse + stock ledger (single source of truth for inventory)
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id       String            @id @default(cuid())
  branchId String
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code     String
  name     String
  type     WarehouseType     @default(MAIN)
  address  String?
  isActive Boolean           @default(true)
  ledger   InventoryLedger[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  goodsReceivings GoodsReceiving[]

  productionMaterialSources    ProductionMaterial[]          @relation("ProductionMaterialFromWarehouse")
  productionOutputs            ProductionOutput[]            @relation("ProductionOutputToWarehouse")
  posSessions                  PosSession[]
  posSales                     PosSale[]
  posReturns                   PosReturn[]
  customerReturns              CustomerReturn[]              @relation("CustomerReturnDestinationWarehouse")
  damageReports                DamageReport[]                @relation("DamageReportSourceWarehouse")
  returnInspectionCases        CustomerReturn[]              @relation("CustomerReturnInspectionWarehouse")
  damageQuarantineCases        DamageReport[]                @relation("DamageReportQuarantineWarehouse")
  wholesaleInvoices            WholesaleInvoice[]
  wholesaleReturns             WholesaleReturn[]
  corporateOrders              CorporateOrder[]
  corporateDeliveries          CorporateDelivery[]
  ecommerceOrders              EcommerceOrder[]
  ecommerceFulfillments        EcommerceFulfillment[]
  productionIssueVouchers      ProductionIssueVoucher[]
  finishedGoodsReceiveVouchers FinishedGoodsReceiveVoucher[]
  corporateSalesReturns        CorporateSalesReturn[]
  showroomStockRequisitions    StockRequisition[]            @relation("StockRequisitionShowroomWarehouse")
  sourceStockRequisitions      StockRequisition[]            @relation("StockRequisitionSourceWarehouse")
  outboundStockTransfers       StockTransfer[]               @relation("StockTransferSourceWarehouse")
  inboundStockTransfers        StockTransfer[]               @relation("StockTransferDestinationWarehouse")

  @@unique([branchId, code])
  @@index([branchId, isActive])
}

model InventoryLedger {
  id          String             @id @default(cuid())
  branchId    String
  branch      Branch             @relation(fields: [branchId], references: [id])
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  direction   InventoryDirection
  quantity    Decimal            @db.Decimal(18, 4)
  costPerUnit Decimal            @default(0) @db.Decimal(18, 4)
  refType     String
  refId       String?
  note        String?
  createdById String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([branchId, warehouseId, productId])
  @@index([refType, refId])
  @@index([createdAt])
}

model StockRequisition {
  id                  String                 @id @default(cuid())
  number              String                 @unique
  branchId            String
  branch              Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  showroomWarehouseId String
  showroomWarehouse   Warehouse              @relation("StockRequisitionShowroomWarehouse", fields: [showroomWarehouseId], references: [id])
  sourceWarehouseId   String?
  sourceWarehouse     Warehouse?             @relation("StockRequisitionSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  priority            String                 @default("MEDIUM")
  requiredDate        DateTime               @db.Date
  status              StockRequisitionStatus @default(SUBMITTED)
  remarks             String?
  approvalNote        String?
  rejectionReason     String?
  requestedById       String?
  approvedById        String?
  rejectedById        String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  completedAt         DateTime?

  items     StockRequisitionItem[]
  transfers StockTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, createdAt])
  @@index([showroomWarehouseId, status])
  @@index([sourceWarehouseId, status])
}

model StockRequisitionItem {
  id            String           @id @default(cuid())
  requisitionId String
  requisition   StockRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  unit          UnitOfMeasure    @default(PCS)
  requestedQty  Decimal          @db.Decimal(18, 4)
  approvedQty   Decimal          @default(0) @db.Decimal(18, 4)
  dispatchedQty Decimal          @default(0) @db.Decimal(18, 4)
  receivedQty   Decimal          @default(0) @db.Decimal(18, 4)
  note          String?

  transferItems StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId])
  @@index([productId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  number          String              @unique
  requisitionId   String
  requisition     StockRequisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fromBranchId    String
  fromBranch      Branch              @relation("StockTransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId      String
  toBranch        Branch              @relation("StockTransferToBranch", fields: [toBranchId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("StockTransferSourceWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("StockTransferDestinationWarehouse", fields: [toWarehouseId], references: [id])
  status          StockTransferStatus @default(PICKING)
  expectedDate    DateTime?           @db.Date
  packedBy        String?
  vehicle         String?
  driverName      String?
  driverPhone     String?
  gatePassNo      String?
  trackingNo      String?
  remarks         String?
  dispatchNote    String?
  receiveRemarks  String?
  createdById     String?
  dispatchedById  String?
  receivedById    String?
  dispatchDate    DateTime?
  receivedDate    DateTime?

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId, status])
  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
}

model StockTransferItem {
  id                String                @id @default(cuid())
  transferId        String
  transfer          StockTransfer         @relation(fields: [transferId], references: [id], onDelete: Cascade)
  requisitionItemId String?
  requisitionItem   StockRequisitionItem? @relation(fields: [requisitionItemId], references: [id], onDelete: SetNull)
  productId         String
  product           Product               @relation(fields: [productId], references: [id])
  quantity          Decimal               @db.Decimal(18, 4)
  receivedQty       Decimal               @default(0) @db.Decimal(18, 4)
  damagedQty        Decimal               @default(0) @db.Decimal(18, 4)
  missingQty        Decimal               @default(0) @db.Decimal(18, 4)
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transferId])
  @@index([productId])
}

model CustomerReturn {
  id                    String               @id @default(cuid())
  number                String               @unique
  branchId              String
  branch                Branch               @relation(fields: [branchId], references: [id])
  warehouseId           String
  warehouse             Warehouse            @relation("CustomerReturnDestinationWarehouse", fields: [warehouseId], references: [id])
  inspectionWarehouseId String
  inspectionWarehouse   Warehouse            @relation("CustomerReturnInspectionWarehouse", fields: [inspectionWarehouseId], references: [id])
  sourceDocumentType    String?
  sourceDocumentNumber  String?
  customerName          String?
  customerPhone         String?
  returnDate            DateTime             @default(now())
  status                CustomerReturnStatus @default(PENDING_INSPECTION)
  financeAction         ReturnFinanceAction  @default(NONE)
  financeNote           String?
  intakeNote            String?
  inspectionNote        String?
  createdById           String?
  inspectedById         String?
  inspectedAt           DateTime?
  completedAt           DateTime?

  items CustomerReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, returnDate])
  @@index([status, createdAt])
}

model CustomerReturnItem {
  id          String                     @id @default(cuid())
  returnId    String
  return      CustomerReturn             @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId   String
  product     Product                    @relation(fields: [productId], references: [id])
  quantity    Decimal                    @db.Decimal(18, 4)
  disposition CustomerReturnDisposition?
  note        String?
  createdAt   DateTime                   @default(now())

  @@index([returnId])
  @@index([productId])
}

model DamageReport {
  id                    String             @id @default(cuid())
  number                String             @unique
  branchId              String
  branch                Branch             @relation(fields: [branchId], references: [id])
  warehouseId           String
  warehouse             Warehouse          @relation("DamageReportSourceWarehouse", fields: [warehouseId], references: [id])
  quarantineWarehouseId String
  quarantineWarehouse   Warehouse          @relation("DamageReportQuarantineWarehouse", fields: [quarantineWarehouseId], references: [id])
  reportDate            DateTime           @default(now())
  reason                String
  note                  String?
  status                DamageReportStatus @default(REPORTED)
  estimatedValue        Decimal            @default(0) @db.Decimal(18, 4)
  requiresApproval      Boolean            @default(false)
  resolution            DamageResolution?
  supplierId            String?
  supplier              Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  grnId                 String?
  grn                   GoodsReceiving?    @relation(fields: [grnId], references: [id], onDelete: SetNull)
  purchaseInvoiceId     String?
  purchaseInvoice       PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  claimAmount           Decimal            @default(0) @db.Decimal(18, 4)
  claimReference        String?
  resolutionNote        String?
  reportedById          String?
  resolvedById          String?
  resolvedAt            DateTime?

  items DamageReportItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, reportDate])
  @@index([status, createdAt])
  @@index([supplierId])
}

model DamageReportItem {
  id          String       @id @default(cuid())
  reportId    String
  report      DamageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Decimal      @db.Decimal(18, 4)
  costPerUnit Decimal      @default(0) @db.Decimal(18, 4)
  note        String?
  createdAt   DateTime     @default(now())

  @@index([reportId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Suppliers
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id             String         @id @default(cuid())
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  /// Human supplier code (e.g. SUP-001)
  code           String
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  paymentTerms   PaymentTerms   @default(NET_30)
  currency       CurrencyCode   @default(BDT)
  openingBalance Decimal        @default(0) @db.Decimal(18, 4)
  status         SupplierStatus @default(ACTIVE)
  notes          String?
  createdById    String?

  purchaseOrders   PurchaseOrder[]
  grns             GoodsReceiving[]
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]
  ledger           SupplierLedger[]
  tradeOrders      TradeOrder[]
  damageReports    DamageReport[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  debitNotes DebitNote[]

  @@unique([branchId, code])
  @@index([branchId, status])
  @@index([name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchase Requisition (PR)
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseRequisition {
  id             String                    @id @default(cuid())
  branchId       String
  branch         Branch                    @relation(fields: [branchId], references: [id])
  /// Human PR number (e.g. PR-2026-001)
  number         String                    @unique
  department     String
  requestedBy    String
  priority       PurchasePriority          @default(MEDIUM)
  status         PurchaseRequisitionStatus @default(DRAFT)
  requiredDate   DateTime
  notes          String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?

  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, createdAt])
  @@index([createdAt])
}

model PurchaseRequisitionItem {
  id             String              @id @default(cuid())
  requisitionId  String
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Free-text name when no SKU exists yet
  productName    String
  unit           UnitOfMeasure       @default(PCS)
  quantity       Decimal             @db.Decimal(18, 4)
  estimatedPrice Decimal             @default(0) @db.Decimal(18, 4)
  note           String?

  @@index([requisitionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchase Order (PO)
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id            String               @id @default(cuid())
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id])
  /// Human PO number (e.g. PO-2026-001)
  number        String               @unique
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  requisitionId String?
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  department    String?
  status        PurchaseOrderStatus  @default(DRAFT)
  orderDate     DateTime             @default(now())
  deliveryDate  DateTime
  currency      CurrencyCode         @default(BDT)
  subtotal      Decimal              @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal              @default(0) @db.Decimal(18, 4)
  discountTotal Decimal              @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal              @default(0) @db.Decimal(18, 4)
  notes         String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  cancelledAt   DateTime?

  items    PurchaseOrderItem[]
  grns     GoodsReceiving[]
  invoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status, createdAt])
  @@index([supplierId])
  @@index([requisitionId])
}

model PurchaseOrderItem {
  id              String                  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product                 @relation(fields: [productId], references: [id])
  accountCategory PurchaseAccountCategory @default(INVENTORY)
  size            String?
  description     String?
  unit            UnitOfMeasure           @default(PCS)
  orderedQty      Decimal                 @db.Decimal(18, 4)
  receivedQty     Decimal                 @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal                 @db.Decimal(18, 4)
  taxRate         Decimal                 @default(0) @db.Decimal(5, 2)
  discountRate    Decimal                 @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal                 @default(0) @db.Decimal(18, 4)

  grnItems GoodsReceivingItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Goods Receiving Note (GRN)
// ─────────────────────────────────────────────────────────────────────────────

model GoodsReceiving {
  id              String               @id @default(cuid())
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id])
  number          String               @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  status          GoodsReceivingStatus @default(DRAFT)
  receivedDate    DateTime             @default(now())
  receivedById    String
  notes           String?
  invoiceId       String?

  items         GoodsReceivingItem[]
  invoices      PurchaseInvoice[]
  damageReports DamageReport[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  debitNotes DebitNote[]

  @@index([branchId, status, createdAt])
  @@index([purchaseOrderId])
  @@index([supplierId])
}

model GoodsReceivingItem {
  id                  String            @id @default(cuid())
  grnId               String
  grn                 GoodsReceiving    @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  size                String?
  receivedQty         Decimal           @db.Decimal(18, 4)
  rejectedQty         Decimal           @default(0) @db.Decimal(18, 4)
  unitCost            Decimal           @db.Decimal(18, 4)
  note                String?

  @@index([grnId])
  @@index([purchaseOrderItemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchase Invoice (supplier bill, 3-way match with PO + GRN)
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseInvoice {
  id              String                @id @default(cuid())
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id])
  number          String                @unique
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  grnId           String?
  grn             GoodsReceiving?       @relation(fields: [grnId], references: [id], onDelete: SetNull)
  status          PurchaseInvoiceStatus @default(DRAFT)
  matching        PurchaseInvoiceMatch  @default(UNMATCHED)
  invoiceDate     DateTime              @default(now())
  dueDate         DateTime
  currency        CurrencyCode          @default(BDT)
  subtotal        Decimal               @default(0) @db.Decimal(18, 4)
  taxTotal        Decimal               @default(0) @db.Decimal(18, 4)
  discountTotal   Decimal               @default(0) @db.Decimal(18, 4)
  grandTotal      Decimal               @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal               @default(0) @db.Decimal(18, 4)
  notes           String?
  createdById     String?

  items         PurchaseInvoiceItem[]
  payments      SupplierPayment[]
  damageReports DamageReport[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  debitNotes DebitNote[]

  @@index([branchId, status, createdAt])
  @@index([supplierId])
  @@index([dueDate])
}

model PurchaseInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  size        String?
  description String?
  unit        UnitOfMeasure   @default(PCS)
  quantity    Decimal         @db.Decimal(18, 4)
  unitPrice   Decimal         @db.Decimal(18, 4)
  taxRate     Decimal         @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal         @db.Decimal(18, 4)

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Supplier Payment
// ─────────────────────────────────────────────────────────────────────────────

model SupplierPayment {
  id          String                @id @default(cuid())
  branchId    String
  branch      Branch                @relation(fields: [branchId], references: [id])
  number      String                @unique
  supplierId  String
  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  invoiceId   String?
  invoice     PurchaseInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  method      SupplierPaymentMethod @default(BANK_TRANSFER)
  paymentDate DateTime              @default(now())
  amount      Decimal               @db.Decimal(18, 4)
  currency    CurrencyCode          @default(BDT)
  reference   String?
  notes       String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, createdAt])
  @@index([supplierId, createdAt])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Supplier Ledger (append-only; runs debit/credit per supplier)
// Debit = purchase (increases payable). Credit = payment (reduces payable).
// ─────────────────────────────────────────────────────────────────────────────

model SupplierLedger {
  id          String                  @id @default(cuid())
  branchId    String
  branch      Branch                  @relation(fields: [branchId], references: [id])
  supplierId  String
  supplier    Supplier                @relation(fields: [supplierId], references: [id])
  entryType   SupplierLedgerEntryType
  refType     String
  refId       String?
  description String
  debit       Decimal                 @default(0) @db.Decimal(18, 4)
  credit      Decimal                 @default(0) @db.Decimal(18, 4)
  entryDate   DateTime                @default(now())
  createdById String?

  createdAt DateTime @default(now())

  @@index([supplierId, createdAt])
  @@index([branchId, createdAt])
  @@index([refType, refId])
}

model DebitNote {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  number        String           @unique
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  invoiceId     String?
  invoice       PurchaseInvoice? @relation(fields: [invoiceId], references: [id])
  grnId         String?
  grn           GoodsReceiving?  @relation(fields: [grnId], references: [id])
  returnDate    DateTime         @default(now())
  status        DebitNoteStatus  @default(DRAFT)
  totalAmount   Decimal          @default(0) @db.Decimal(18, 4)
  vatAdjustment Decimal          @default(0) @db.Decimal(18, 4)
  reason        String?
  createdById   String?

  items DebitNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([supplierId])
}

model DebitNoteItem {
  id          String    @id @default(cuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  returnedQty Decimal   @db.Decimal(18, 4)
  unitPrice   Decimal   @db.Decimal(18, 4)
  total       Decimal   @db.Decimal(18, 4)
  reason      String?
  condition   String?

  @@index([debitNoteId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Factory Management
// Production orders convert raw materials into finished goods. Material issue
// and finished-goods receipt both post InventoryLedger rows in the same
// transaction as the production movement that triggered them.
// ─────────────────────────────────────────────────────────────────────────────

model ProductionPlan {
  id               String               @id @default(cuid())
  planNo           String               @unique
  planningDate     DateTime             @db.Date
  branchId         String
  branch           Branch               @relation(fields: [branchId], references: [id])
  productId        String
  product          Product              @relation(fields: [productId], references: [id])
  quantity         Decimal              @db.Decimal(18, 4)
  priority         String?
  plannedStartDate DateTime
  plannedEndDate   DateTime
  productionLine   String?
  machine          String?
  shift            String?
  plannerId        String?
  planner          User?                @relation("PlannerRelation", fields: [plannerId], references: [id])
  status           ProductionPlanStatus @default(DRAFT)

  orders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([productId])
}

model ProductionOrder {
  id               String                @id @default(cuid())
  branchId         String
  branch           Branch                @relation(fields: [branchId], references: [id])
  /// Human production order number (e.g. PRO-2026-001)
  number           String                @unique
  productId        String
  product          Product               @relation("ProductionOutputProduct", fields: [productId], references: [id])
  planId           String?
  plan             ProductionPlan?       @relation(fields: [planId], references: [id])
  plannedQty       Decimal               @db.Decimal(18, 4)
  producedQty      Decimal               @default(0) @db.Decimal(18, 4)
  unit             UnitOfMeasure         @default(PCS)
  status           ProductionOrderStatus @default(DRAFT)
  plannedStartDate DateTime
  plannedEndDate   DateTime
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  notes            String?
  overheadRate     Decimal?              @db.Decimal(7, 4)
  buyerName        String?
  batchName        String?
  saleAmount       Decimal?              @db.Decimal(18, 4)
  createdById      String?

  stages      ProductionStage[]
  materials   ProductionMaterial[]
  outputs     ProductionOutput[]
  costEntries ProductionCostEntry[]

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  productionIssueVouchers      ProductionIssueVoucher[]
  processTrackings             ProcessTracking[]
  wipLedgers                   WipLedger[]
  scrapLedgers                 ScrapLedger[]
  finishedGoodsReceiveVouchers FinishedGoodsReceiveVoucher[]
  workOrders                   WorkOrder[]

  @@index([branchId, status, createdAt])
  @@index([productId])
  @@index([plannedEndDate])
}

model WorkOrder {
  id          String          @id @default(cuid())
  workOrderNo String          @unique
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  department  String?
  machine     String?
  operatorId  String?
  operator    Employee?       @relation(fields: [operatorId], references: [id])
  shift       String?
  inputQty    Decimal         @default(0) @db.Decimal(18, 4)
  targetQty   Decimal         @db.Decimal(18, 4)
  outputQty   Decimal         @default(0) @db.Decimal(18, 4)
  scrapQty    Decimal         @default(0) @db.Decimal(18, 4)
  status      WorkOrderStatus @default(PENDING)

  startTime DateTime?
  endTime   DateTime?

  delays DelayTracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
  @@index([operatorId])
}

model DelayTracking {
  id           String      @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  reason       DelayReason
  notes        String?
  startTime    DateTime
  endTime      DateTime?
  durationMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId])
}

model ProductionStage {
  id               String                @id @default(cuid())
  orderId          String
  order            ProductionOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence         Int
  name             String
  status           ProductionStageStatus @default(PENDING)
  startedAt        DateTime?
  completedAt      DateTime?
  notes            String?
  processTrackings ProcessTracking[]
  wipLedgers       WipLedger[]
  scrapLedgers     ScrapLedger[]

  @@unique([orderId, sequence])
  @@index([orderId])
}

model ProductionMaterial {
  id              String                 @id @default(cuid())
  orderId         String
  order           ProductionOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product                @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure          @default(PCS)
  plannedQty      Decimal                @db.Decimal(18, 4)
  consumedQty     Decimal                @default(0) @db.Decimal(18, 4)
  fromWarehouseId String?
  fromWarehouse   Warehouse?             @relation("ProductionMaterialFromWarehouse", fields: [fromWarehouseId], references: [id])
  materialType    ProductionMaterialType @default(OTHER)
  unitCost        Decimal?               @db.Decimal(18, 4)
  note            String?

  @@index([orderId])
  @@index([productId])
}

model ProductionOutput {
  id            String          @id @default(cuid())
  orderId       String
  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  unit          UnitOfMeasure   @default(PCS)
  quantity      Decimal         @db.Decimal(18, 4)
  costPerUnit   Decimal         @default(0) @db.Decimal(18, 4)
  toWarehouseId String
  toWarehouse   Warehouse       @relation("ProductionOutputToWarehouse", fields: [toWarehouseId], references: [id])
  note          String?
  createdById   String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId, createdAt])
}

model ProductionCostEntry {
  id          String             @id @default(cuid())
  orderId     String
  order       ProductionOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        ProductionCostType
  description String             @db.VarChar(255)
  hours       Decimal?           @db.Decimal(10, 4)
  rate        Decimal?           @db.Decimal(18, 4)
  amount      Decimal            @db.Decimal(18, 4)
  note        String?            @db.VarChar(500)
  createdById String?
  createdAt   DateTime           @default(now())

  @@index([orderId, type])
  @@index([createdAt])
}

model ProductionIssueVoucher {
  id            String                @id @default(cuid())
  voucherNo     String                @unique
  date          DateTime              @db.Date
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id])
  orderId       String
  order         ProductionOrder       @relation(fields: [orderId], references: [id])
  warehouseId   String
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  status        ProductionIssueStatus @default(DRAFT)
  requestedById String?
  requestedBy   User?                 @relation("IssueRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                 @relation("IssueApprovedBy", fields: [approvedById], references: [id])
  issuedById    String?
  issuedBy      User?                 @relation("IssueIssuedBy", fields: [issuedById], references: [id])
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items ProductionIssueItem[]
}

model ProductionIssueItem {
  id          String                 @id @default(cuid())
  voucherId   String
  voucher     ProductionIssueVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId   String
  product     Product                @relation(fields: [productId], references: [id])
  batchNo     String?
  lotNo       String?
  requiredQty Decimal                @db.Decimal(18, 4)
  issuedQty   Decimal                @default(0) @db.Decimal(18, 4)
  uom         UnitOfMeasure          @default(PCS)
}

model ProcessTracking {
  id         String          @id @default(cuid())
  trackingNo String          @unique
  orderId    String
  order      ProductionOrder @relation(fields: [orderId], references: [id])
  branchId   String
  branch     Branch          @relation(fields: [branchId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  stageId    String
  stage      ProductionStage @relation(fields: [stageId], references: [id])
  batchNo    String?

  machine    String?
  operatorId String?
  operator   Employee? @relation(fields: [operatorId], references: [id])

  status          ProcessTrackingStatus @default(PENDING)
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int?

  inputQty     Decimal @default(0) @db.Decimal(18, 4)
  outputQty    Decimal @default(0) @db.Decimal(18, 4)
  rejectedQty  Decimal @default(0) @db.Decimal(18, 4)
  scrapQty     Decimal @default(0) @db.Decimal(18, 4)
  reworkQty    Decimal @default(0) @db.Decimal(18, 4)
  remainingQty Decimal @default(0) @db.Decimal(18, 4)

  materialCost     Decimal @default(0) @db.Decimal(18, 4)
  labourCost       Decimal @default(0) @db.Decimal(18, 4)
  machineCost      Decimal @default(0) @db.Decimal(18, 4)
  overheadCost     Decimal @default(0) @db.Decimal(18, 4)
  totalProcessCost Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WipLedger {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  orderId   String
  order     ProductionOrder  @relation(fields: [orderId], references: [id])
  stageId   String?
  stage     ProductionStage? @relation(fields: [stageId], references: [id])
  productId String
  product   Product          @relation(fields: [productId], references: [id])

  voucher    String?
  operatorId String?
  operator   Employee? @relation(fields: [operatorId], references: [id])

  inQty   Decimal @default(0) @db.Decimal(18, 4)
  outQty  Decimal @default(0) @db.Decimal(18, 4)
  balance Decimal @default(0) @db.Decimal(18, 4)
  cost    Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
}

model ScrapLedger {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  orderId   String
  order     ProductionOrder  @relation(fields: [orderId], references: [id])
  stageId   String?
  stage     ProductionStage? @relation(fields: [stageId], references: [id])
  scrapType String

  operatorId String?
  operator   Employee? @relation(fields: [operatorId], references: [id])

  qty   Decimal @db.Decimal(18, 4)
  cost  Decimal @default(0) @db.Decimal(18, 4)
